# Shared web and worker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patchrail
APP_URL=http://localhost:3000
# Use the OAuth client credentials from this same GitHub App. Authentication
# and installation access remain separate flows/tokens inside Patchrail.
AUTH_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App repository access (separate authorization from OAuth login)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# AI runtime. Runs stay disabled until all pricing fields are configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_INPUT_USD_PER_1M=
OPENAI_OUTPUT_USD_PER_1M=
# Copy the current rates for the selected model/tool from OpenAI's official
# pricing page. Patchrail intentionally refuses zero/missing values.
OPENAI_CACHED_INPUT_USD_PER_1M=
# The long-context tier applies to the entire request only after its configured
# input-token threshold is exceeded. Keep these values current for the model.
OPENAI_LONG_CONTEXT_THRESHOLD_TOKENS=
OPENAI_LONG_CONTEXT_INPUT_USD_PER_1M=
OPENAI_LONG_CONTEXT_CACHED_INPUT_USD_PER_1M=
OPENAI_LONG_CONTEXT_OUTPUT_USD_PER_1M=
OPENAI_WEB_SEARCH_USD_PER_CALL=
OPENAI_MAX_WEB_SEARCH_CALLS_PER_RESPONSE=4
AI_MAX_RUN_COST_USD=5
AI_MAX_MODEL_CALLS=22
AI_MAX_RESEARCH_CALLS=12
AI_MAX_REPOSITORY_READS=80
AI_MAX_FILES_WRITTEN=20
AI_MAX_CONTEXT_BYTES=250000
AI_MAX_INPUT_TOKENS=400000
AI_MAX_OUTPUT_TOKENS=20000
AI_MAX_REPAIR_ATTEMPTS=1
AI_MAX_ELAPSED_MINUTES=45

# Plan controls
FREE_REPOSITORY_LIMIT=1
PRO_REPOSITORY_LIMIT=20
FREE_AI_BUDGET_USD=5
PRO_AI_BUDGET_USD=100

# Stripe test or live-mode configuration
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_KEY=patchrail
STRIPE_PRO_LOOKUP_KEY=patchrail_pro_monthly

# Verification. Use railway_sandbox in production when enabled, or external_runner.
VERIFICATION_MODE=external_runner
RUNNER_SHARED_SECRET=
RUNNER_BASE_URL=http://localhost:3000
RUNNER_POLL_INTERVAL_MS=3000
RUNNER_MAX_CONCURRENCY=1
RUNNER_LEASE_SECONDS=90
VERIFICATION_CPU_LIMIT=2
VERIFICATION_MEMORY_MB=4096
VERIFICATION_TIMEOUT_SECONDS=1200

# Railway Sandboxes (beta) are only needed for VERIFICATION_MODE=railway_sandbox.
RAILWAY_TOKEN=
RAILWAY_API_TOKEN=
RAILWAY_ENVIRONMENT_ID=
# Trial projects currently allow at most 5; raise only when the Railway plan supports it.
RAILWAY_SANDBOX_IDLE_TIMEOUT_MINUTES=5

# Worker
WORKER_POLL_INTERVAL_MS=3000
WORKER_CONCURRENCY=2
WORKER_STALE_AFTER_MINUTES=15
