{
  "name": "patchrail",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --conditions=react-server --import tsx worker/index.ts",
    "runner": "tsx runner/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.27",
    "@octokit/auth-app": "8.3.0",
    "@octokit/rest": "22.0.1",
    "@stripe/react-stripe-js": "6.8.1",
    "@stripe/stripe-js": "9.13.0",
    "better-auth": "1.6.27",
    "drizzle-orm": "0.45.2",
    "diff": "9.0.0",
    "lucide-react": "0.544.0",
    "next": "16.3.0",
    "openai": "7.4.0",
    "postgres": "3.4.9",
    "railway": "3.9.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "stripe": "22.5.0",
    "tar": "7.5.22",
    "tsx": "4.23.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/diff": "8.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
